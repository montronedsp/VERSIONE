# Normalize text files to LF so rustfmt (newline_style = Unix) passes on all CI hosts.
* text=auto eol=lf

*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Keep license and attributes themselves as LF.
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
